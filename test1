<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBHS Football Booster Club - Go Broncos!</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Load Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Custom styles for the team theme */
        :root {
            --primary-color: #1e3a8a; /* Dark Blue (MBHS Primary) */
            --secondary-color: #dc2626; /* Red (New Accent Color) */
        }
        .bg-primary { background-color: var(--primary-color); }
        .text-primary { color: var(--primary-color); }
        .bg-secondary { background-color: var(--secondary-color); }
        .text-secondary { color: var(--secondary-color); }

        /* Custom scroll behavior */
        html {
            scroll-behavior: smooth;
        }

        /* Ensure smooth icon loading */
        [data-lucide] {
            stroke-width: 2.5;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans antialiased">

    <!-- Header & Navigation -->
    <header class="sticky top-0 z-50 shadow-lg bg-primary/95 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo/Title -->
                <div class="flex items-center">
                    <div class="text-2xl font-extrabold text-white tracking-tight">
                        <span class="text-secondary">MBHS</span> Booster Club
                    </div>
                </div>
                <!-- Desktop Navigation -->
                <nav class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <a href="#home" class="text-white hover:text-secondary px-3 py-2 rounded-md text-sm font-medium transition duration-150">Home</a>
                        <a href="#about" class="text-white hover:text-secondary px-3 py-2 rounded-md text-sm font-medium transition duration-150">About</a>
                        <a href="#events" class="text-white hover:text-secondary px-3 py-2 rounded-md text-sm font-medium transition duration-150">Events</a>
                        <a href="#support" class="bg-secondary text-white px-3 py-2 rounded-md text-sm font-bold shadow-md hover:bg-red-700 transition duration-150">Join / Donate</a>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <main class="relative">

        <!-- 1. Hero Section (Home) -->
        <section id="home" class="relative overflow-hidden pt-16 pb-24 bg-gray-900">
            <!-- Background Image Placeholder (MBHS Broncos) - Updated colors -->
            <div class="absolute inset-0 opacity-20">
                <img src="https://placehold.co/1920x1080/1e3a8a/dc2626?text=McKinney+Boyd+Broncos"
                     class="w-full h-full object-cover"
                     alt="McKinney Boyd Football Team on the field">
                <div class="absolute inset-0 bg-primary opacity-80"></div>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                <h1 class="text-5xl sm:text-7xl font-extrabold text-white leading-tight mt-12 mb-6">
                    Fueling the Fire for the <span class="text-secondary block md:inline">Broncos!</span>
                </h1>
                <p class="text-xl text-gray-200 max-w-3xl mx-auto mb-10">
                    The MBHS Football Booster Club supports our student-athletes by providing resources, fostering team spirit, and building a winning culture.
                </p>
                <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-6">
                    <a href="#support" class="inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-bold rounded-xl shadow-2xl text-white bg-secondary hover:bg-red-700 transition duration-300 transform hover:scale-[1.02]">
                        <span data-lucide="medal" class="w-5 h-5 mr-2"></span>
                        Become a Member Today
                    </a>
                    <a href="#events" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-base font-medium rounded-xl text-white hover:bg-white hover:text-primary transition duration-300">
                        View Upcoming Events
                    </a>
                </div>
            </div>
        </section>

        <!-- 2. About Section -->
        <section id="about" class="py-20 sm:py-24 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-4xl font-extrabold text-primary text-center mb-12">Our Mission & Impact</h2>
                <div class="grid md:grid-cols-2 gap-10 items-center">
                    <div>
                        <p class="text-lg text-gray-700 mb-6">
                            The McKinney Boyd Football Booster Club is a non-profit organization dedicated to enhancing the experience of every student-athlete in the MBHS football program. We work closely with the coaching staff and school administration to ensure the team has the necessary resources to compete at the highest level.
                        </p>
                        <p class="text-lg text-gray-700 mb-6 font-semibold">
                            Every dollar raised goes directly back to the program, supporting critical needs outside the standard school budget.
                        </p>
                        <ul class="space-y-3 text-gray-700">
                            <li class="flex items-center">
                                <span data-lucide="check-circle" class="w-5 h-5 text-secondary mr-3"></span>
                                New equipment and safety gear
                            </li>
                            <li class="flex items-center">
                                <span data-lucide="check-circle" class="w-5 h-5 text-secondary mr-3"></span>
                                Team meals and pre-game nutrition
                            </li>
                            <li class="flex items-center">
                                <span data-lucide="check-circle" class="w-5 h-5 text-secondary mr-3"></span>
                                Senior scholarships and recognition events
                            </li>
                            <li class="flex items-center">
                                <span data-lucide="check-circle" class="w-5 h-5 text-secondary mr-3"></span>
                                Upgraded training tools and facilities
                            </li>
                        </ul>
                    </div>
                    <div class="hidden md:block">
                        <img src="https://placehold.co/600x400/f3f4f6/1e3a8a?text=Proud+Supporters"
                             class="rounded-2xl shadow-xl w-full"
                             alt="Booster club members cheering">
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. Events Section -->
        <section id="events" class="py-20 sm:py-24 bg-gray-100">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-4xl font-extrabold text-primary text-center mb-16">Upcoming Events & Important Dates</h2>

                <div class="grid md:grid-cols-3 gap-8">

                    <!-- Event Card 1 -->
                    <div class="bg-white rounded-xl shadow-xl overflow-hidden hover:shadow-2xl transition duration-300">
                        <div class="bg-primary px-6 py-4 text-center">
                            <p class="text-sm font-medium text-gray-200">OCT 14, 2025</p>
                            <h3 class="text-xl font-bold text-white">Monthly Booster Meeting</h3>
                        </div>
                        <div class="p-6">
                            <p class="text-gray-600 mb-4">Join us to discuss fundraising goals, game day logistics, and volunteer opportunities.</p>
                            <div class="flex items-center text-sm text-gray-500 mb-2">
                                <span data-lucide="clock" class="w-4 h-4 mr-2"></span>
                                7:00 PM - 8:30 PM
                            </div>
                            <div class="flex items-center text-sm text-gray-500">
                                <span data-lucide="map-pin" class="w-4 h-4 mr-2"></span>
                                MBHS Library Annex
                            </div>
                        </div>
                    </div>

                    <!-- Event Card 2 - Updated secondary color usage -->
                    <div class="bg-white rounded-xl shadow-xl overflow-hidden hover:shadow-2xl transition duration-300">
                        <div class="bg-secondary px-6 py-4 text-center">
                            <p class="text-sm font-medium text-white">OCT 28, 2025</p>
                            <h3 class="text-xl font-bold text-white">Bronco Home Game Tailgate</h3>
                        </div>
                        <div class="p-6">
                            <p class="text-gray-600 mb-4">The annual pre-game tailgate! Food trucks, music, and spirit wear sales.</p>
                            <div class="flex items-center text-sm text-gray-500 mb-2">
                                <span data-lucide="clock" class="w-4 h-4 mr-2"></span>
                                5:00 PM - 7:00 PM
                            </div>
                            <div class="flex items-center text-sm text-gray-500">
                                <span data-lucide="map-pin" class="w-4 h-4 mr-2"></span>
                                Stadium Parking Lot C
                            </div>
                        </div>
                    </div>

                    <!-- Event Card 3 -->
                    <div class="bg-white rounded-xl shadow-xl overflow-hidden hover:shadow-2xl transition duration-300">
                        <div class="bg-primary/90 px-6 py-4 text-center">
                            <p class="text-sm font-medium text-gray-200">NOV 18, 2025</p>
                            <h3 class="text-xl font-bold text-white">Annual Senior Banquet</h3>
                        </div>
                        <div class="p-6">
                            <p class="text-gray-600 mb-4">A special night to honor our graduating seniors and their commitment to the team.</p>
                            <div class="flex items-center text-sm text-gray-500 mb-2">
                                <span data-lucide="clock" class="w-4 h-4 mr-2"></span>
                                6:30 PM
                            </div>
                            <div class="flex items-center text-sm text-gray-500">
                                <span data-lucide="map-pin" class="w-4 h-4 mr-2"></span>
                                Omni Frisco Hotel (Ballroom)
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 4. Support/Membership Section -->
        <section id="support" class="py-20 sm:py-24 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="text-4xl font-extrabold text-primary text-center mb-4">Join the Club & Donate</h2>
                <p class="text-xl text-gray-600 text-center max-w-2xl mx-auto mb-16">
                    Choose the membership level that fits you best and directly invest in the success of the MBHS Football Program.
                </p>

                <div class="grid lg:grid-cols-3 gap-8">

                    <!-- Tier 1 -->
                    <div class="bg-gray-100 p-8 rounded-xl shadow-xl text-center flex flex-col justify-between transform hover:scale-[1.02] transition duration-300">
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800 mb-3">Bronze Bronco</h3>
                            <p class="text-5xl font-extrabold text-primary mb-6">$50</p>
                            <ul class="text-left space-y-3 text-gray-600 mb-8">
                                <li class="flex items-center"><span data-lucide="star" class="w-4 h-4 text-secondary mr-2"></span>Email updates & newsletters</li>
                                <li class="flex items-center"><span data-lucide="star" class="w-4 h-4 text-secondary mr-2"></span>Booster Club Decal</li>
                                <li class="flex items-center"><span data-lucide="star" class="w-4 h-4 text-secondary mr-2"></span>Recognition on website (small text)</li>
                            </ul>
                        </div>
                        <button class="w-full bg-primary text-white py-3 rounded-lg font-bold hover:bg-primary/90 transition duration-150 shadow-md">
                            Select Bronze Tier
                        </button>
                    </div>

                    <!-- Tier 2 (Featured) - Updated for Red accent -->
                    <div class="bg-primary p-8 rounded-xl shadow-2xl text-center flex flex-col justify-between ring-4 ring-secondary transform scale-[1.05]">
                        <div>
                            <div class="bg-secondary text-white font-bold px-3 py-1 rounded-full inline-block mb-3">BEST VALUE</div>
                            <h3 class="text-3xl font-bold text-white mb-3">Gold Sponsor</h3>
                            <p class="text-6xl font-extrabold text-secondary mb-6">$250</p>
                            <ul class="text-left space-y-4 text-gray-200 mb-8">
                                <li class="flex items-center"><span data-lucide="trophy" class="w-5 h-5 text-secondary mr-2"></span>All Bronze/Silver benefits</li>
                                <li class="flex items-center"><span data-lucide="trophy" class="w-5 h-5 text-secondary mr-2"></span>Two All-Access Season Passes</li>
                                <li class="flex items-center"><span data-lucide="trophy" class="w-5 h-5 text-secondary mr-2"></span>Large business logo/family name on banner</li>
                                <li class="flex items-center"><span data-lucide="trophy" class="w-5 h-5 text-secondary mr-2"></span>Exclusive Spirit Wear Item</li>
                            </ul>
                        </div>
                        <button class="w-full bg-secondary text-white py-4 rounded-lg font-extrabold hover:bg-red-700 transition duration-150 shadow-2xl">
                            Go for Gold!
                        </button>
                    </div>

                    <!-- Tier 3 -->
                    <div class="bg-gray-100 p-8 rounded-xl shadow-xl text-center flex flex-col justify-between transform hover:scale-[1.02] transition duration-300">
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800 mb-3">Silver Supporter</h3>
                            <p class="text-5xl font-extrabold text-primary mb-6">$100</p>
                            <ul class="text-left space-y-3 text-gray-600 mb-8">
                                <li class="flex items-center"><span data-lucide="star" class="w-4 h-4 text-secondary mr-2"></span>All Bronze benefits</li>
                                <li class="flex items-center"><span data-lucide="star" class="w-4 h-4 text-secondary mr-2"></span>Priority seating at meetings</li>
                                <li class="flex items-center"><span data-lucide="star" class="w-4 h-4 text-secondary mr-2"></span>Medium recognition on website</li>
                            </ul>
                        </div>
                        <button class="w-full bg-primary text-white py-3 rounded-lg font-bold hover:bg-primary/90 transition duration-150 shadow-md">
                            Select Silver Tier
                        </button>
                    </div>

                </div>
            </div>
        </section>

        <!-- 5. Call to Action / Contact - Secondary color updated for button -->
        <section id="contact" class="py-16 bg-primary">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
                <h2 class="text-3xl font-extrabold mb-4">Have Questions or Want to Volunteer?</h2>
                <p class="text-xl text-gray-200 mb-8">
                    We rely on the generosity and time of our community. Reach out to the Booster Club Board.
                </p>
                <a href="mailto:info@mbhsfootballbooster.org" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-bold rounded-lg shadow-xl text-white bg-secondary hover:bg-red-700 transition duration-300">
                    <span data-lucide="mail" class="w-5 h-5 mr-2"></span>
                    Email the Board
                </a>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 border-b border-gray-700 pb-8 mb-8">
                <!-- Club Info -->
                <div class="col-span-1">
                    <h4 class="text-lg font-bold text-secondary mb-3">MBHS Booster Club</h4>
                    <p class="text-sm text-gray-400">
                        Supporting McKinney Boyd High School Football, located in McKinney, Texas.
                    </p>
                </div>
                <!-- Quick Links -->
                <div class="col-span-1">
                    <h4 class="text-lg font-bold text-secondary mb-3">Quick Links</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#about" class="text-gray-400 hover:text-white transition">About Us</a></li>
                        <li><a href="#events" class="text-gray-400 hover:text-white transition">Events Calendar</a></li>
                        <li><a href="#support" class="text-gray-400 hover:text-white transition">Membership Tiers</a></li>
                    </ul>
                </div>
                <!-- Contact Info -->
                <div class="col-span-1">
                    <h4 class="text-lg font-bold text-secondary mb-3">Contact</h4>
                    <ul class="space-y-2 text-sm">
                        <li class="text-gray-400 flex items-center">
                            <span data-lucide="phone" class="w-4 h-4 mr-2"></span> (469) 555-MBHS
                        </li>
                        <li class="text-gray-400 flex items-center">
                            <span data-lucide="mail" class="w-4 h-4 mr-2"></span> info@mbhsfootball.org
                        </li>
                    </ul>
                </div>
                <!-- Social Media -->
                <div class="col-span-1">
                    <h4 class="text-lg font-bold text-secondary mb-3">Connect</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-white transition" aria-label="Facebook">
                            <span data-lucide="facebook" class="w-6 h-6"></span>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition" aria-label="Instagram">
                            <span data-lucide="instagram" class="w-6 h-6"></span>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition" aria-label="Twitter">
                            <span data-lucide="twitter" class="w-6 h-6"></span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Copyright -->
            <div class="text-center text-sm text-gray-500 pt-4">
                &copy; <span id="currentYear"></span> McKinney Boyd High School Football Booster Club. All Rights Reserved.
            </div>
        </div>
    </footer>

    <!-- Initialize Lucide Icons & Footer Year -->
    <script>
        // Set current year in the footer
        document.getElementById('currentYear').textContent = new Date().getFullYear();

        // Initialize Lucide icons
        lucide.createIcons();
    </script>
</body>
</html>
